---
import Base from '../../../layouts/Base.astro';
import { languages, t } from '../../../i18n/index.js';
import { lessons } from '../../../content.js';

export function getStaticPaths() {
  return languages.flatMap((lang) => lessons(lang).map((l) => ({ params: { lang, slug: l.slug } })));
}
const { lang, slug } = Astro.params;
const all = lessons(lang);
const index = all.findIndex((l) => l.slug === slug);
const lesson = all[index];
const previous = all[index - 1];
const next = all[index + 1];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = lesson;
---
<Base lang={lang} title={lesson.title} slug={slug}>
  <div class="layout">
    <nav class="toc" aria-label={t(lang, 'lesson.contents')}>
      <h2>{t(lang, 'lesson.contents')}</h2>
      <ol>
        {all.map((l) => (
          <li><a href={`${base}/${lang}/cours/${l.slug}/`} aria-current={l.slug === slug ? 'page' : undefined}><span class="n">{l.slug.slice(0, 2)}</span><span>{l.title}</span></a></li>
        ))}
      </ol>
    </nav>
    <div>
      <article>
        <Content />
      </article>
      <nav class="pager" aria-label="Navigation">
        {previous ? <a href={`${base}/${lang}/cours/${previous.slug}/`}>← {t(lang, 'previous')}</a> : <span />}
        {next ? <a href={`${base}/${lang}/cours/${next.slug}/`}>{t(lang, 'next')} →</a> : <span />}
      </nav>
    </div>
  </div>
</Base>
