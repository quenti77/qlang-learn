---
import Base from '../../../layouts/Base.astro';
import Sidebar from '../../../components/Sidebar.astro';
import Outline from '../../../components/Outline.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Related from '../../../components/Related.astro';
import { languages, t } from '../../../i18n/index.js';
import { lessons, lessonParts, docsForLesson } from '../../../content.js';

export function getStaticPaths() {
  return languages.flatMap((lang) => lessons(lang).map((l) => ({ params: { lang, slug: l.slug } })));
}
const { lang, slug } = Astro.params;
const all = lessons(lang);
const index = all.findIndex((l) => l.slug === slug);
const lesson = all[index];
const previous = all[index - 1];
const next = all[index + 1];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = lesson;
const href = (l) => `${base}/${lang}/cours/${l.slug}/`;
const groups = lessonParts(lang).map((p) => ({
  name: t(lang, `part.${p.id}`),
  items: p.lessons.map((l) => ({ href: href(l), label: l.title, n: l.slug.slice(0, 2), slug: l.slug, current: l.slug === slug })),
}));
const crumbs = [
  { label: t(lang, 'nav.lessons'), href: `${base}/${lang}/` },
  { label: t(lang, `part.${lesson.part}`) },
  { label: lesson.title },
];
const related = docsForLesson(lang, slug).map((p) => ({ href: `${base}/${lang}/docs/${p.slug}/`, label: p.title }));
---
<Base lang={lang} title={lesson.title} slug={slug}>
  <div class="layout with-outline">
    <Sidebar
      lessons
      title={t(lang, 'lesson.contents')}
      menuLabel={t(lang, 'menu.chapters')}
      currentLabel={`${lesson.slug.slice(0, 2)}. ${lesson.title}`}
      groups={groups}
    />
    <div>
      <Breadcrumb items={crumbs} label={t(lang, 'breadcrumb')} />
      <article data-series={`lesson-${slug}`} data-lesson={slug} data-pagefind-body data-section="cours" data-pagefind-filter="section[data-section]" data-part={crumbs[1].label} data-pagefind-meta="part[data-part]">
        <Content />
      </article>
      <Related title={t(lang, 'related.docs')} pages={related} />
      <nav class="pager" aria-label="Navigation">
        {previous ? <a href={href(previous)} rel="prev"><small>← {t(lang, 'previous')}</small><span>{previous.title}</span></a> : <span />}
        {next ? <a href={href(next)} rel="next" class="next"><small>{t(lang, 'next')} →</small><span>{next.title}</span></a> : <span />}
      </nav>
    </div>
    <Outline title={t(lang, 'outline.title')} headings={lesson.headings} />
  </div>
</Base>
