---
import Base from '../../../layouts/Base.astro';
import Sidebar from '../../../components/Sidebar.astro';
import Outline from '../../../components/Outline.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Related from '../../../components/Related.astro';
import { languages, t } from '../../../i18n/index.js';
import { docGroups, docPages, lessonsForDoc } from '../../../content.js';

export function getStaticPaths() {
  return languages.flatMap((lang) => docPages(lang).map((p) => ({ params: { lang, slug: p.slug } })));
}
const { lang, slug } = Astro.params;
const all = docPages(lang);
const index = all.findIndex((p) => p.slug === slug);
const page = all[index];
const previous = all[index - 1];
const next = all[index + 1];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = page;
const href = (p) => `${base}/${lang}/docs/${p.slug}/`;
const groups = docGroups(lang).map((g) => ({
  name: g.name,
  items: g.pages.map((p) => ({ href: href(p), label: p.title, slug: p.slug, current: p.slug === slug })),
}));
const crumbs = [
  { label: t(lang, 'docs.title'), href: `${base}/${lang}/docs/` },
  { label: page.group },
  { label: page.title },
];
const related = lessonsForDoc(lang, slug).map((l) => ({ href: `${base}/${lang}/cours/${l.slug}/`, label: l.title }));
---
<Base lang={lang} title={page.title} slug={slug} section="docs">
  <div class="layout with-outline">
    <Sidebar
      title={t(lang, 'docs.title')}
      titleHref={`${base}/${lang}/docs/`}
      menuLabel={t(lang, 'menu.docs')}
      currentLabel={page.title}
      groups={groups}
    />
    <div>
      <Breadcrumb items={crumbs} label={t(lang, 'breadcrumb')} />
      <article class="reference" data-pagefind-body data-section="docs" data-pagefind-filter="section[data-section]" data-part={page.group} data-pagefind-meta="part[data-part]">
        <Content />
      </article>
      <Related title={t(lang, 'related.lessons')} pages={related} />
      <nav class="pager" aria-label="Navigation">
        {previous ? <a href={href(previous)} rel="prev"><small>← {t(lang, 'pager.previous')}</small><span>{previous.title}</span></a> : <span />}
        {next ? <a href={href(next)} rel="next" class="next"><small>{t(lang, 'pager.next')} →</small><span>{next.title}</span></a> : <span />}
      </nav>
    </div>
    <Outline title={t(lang, 'outline.title')} headings={page.headings} />
  </div>
</Base>
