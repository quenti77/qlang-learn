---
import Base from '../../../layouts/Base.astro';
import { languages, t } from '../../../i18n/index.js';
import { docGroups } from '../../../content.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = docGroups(lang);
---
<Base lang={lang} title={t(lang, 'docs.title')} section="docs">
  <section class="home-lessons" style="padding-top: 2rem">
    <h1>{t(lang, 'docs.title')}</h1>
    {groups.length === 0 ? <p>{t(lang, 'docs.none')}</p> : (
      <>
        <p>{t(lang, 'docs.intro')}</p>
        {groups.map((group) => (
          <>
            <h2>{group.name}</h2>
            <ul class="lesson-list">
              {group.pages.map((p) => <li><a href={`${base}/${lang}/docs/${p.slug}/`}><span>{p.title}</span></a></li>)}
            </ul>
          </>
        ))}
      </>
    )}
  </section>
</Base>
