---
import Base from '../../../layouts/Base.astro';
import { languages } from '../../../i18n/index.js';
import { toolPages } from '../../../content.js';

export function getStaticPaths() {
  return languages.flatMap((lang) => toolPages(lang).map((p) => ({ params: { lang, slug: p.slug } })));
}
const { lang, slug } = Astro.params;
const page = toolPages(lang).find((p) => p.slug === slug);
const { Content } = page;
---
<Base lang={lang} title={page.title} slug={slug} section="outils">
  <div class="layout single">
    <article>
      <Content />
    </article>
  </div>
</Base>
