---
import Base from '../../../layouts/Base.astro';
import { languages, t } from '../../../i18n/index.js';
import { referencePages } from '../../../content.js';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pages = referencePages(lang);
---
<Base lang={lang} title={t(lang, 'reference.title')} section="reference">
  <section class="home-lessons" style="padding-top: 2rem">
    <h1>{t(lang, 'reference.title')}</h1>
    {pages.length === 0 ? <p>{t(lang, 'reference.none')}</p> : (
      <>
        <p>{t(lang, 'reference.intro')}</p>
        <ol class="lesson-list">
          {pages.map((p) => <li><a href={`${base}/${lang}/reference/${p.slug}/`}><span class="n">{p.slug.slice(0, 2)}</span><span>{p.title}</span></a></li>)}
        </ol>
      </>
    )}
  </section>
</Base>
