---
import Base from '../../../layouts/Base.astro';
import { languages, t } from '../../../i18n/index.js';
import { referencePages } from '../../../content.js';

export function getStaticPaths() {
  return languages.flatMap((lang) => referencePages(lang).map((p) => ({ params: { lang, slug: p.slug } })));
}
const { lang, slug } = Astro.params;
const all = referencePages(lang);
const index = all.findIndex((p) => p.slug === slug);
const page = all[index];
const previous = all[index - 1];
const next = all[index + 1];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = page;
---
<Base lang={lang} title={page.title} slug={slug} section="reference">
  <div class="layout">
    <nav class="toc" aria-label={t(lang, 'reference.chapters')}>
      <h2><a href={`${base}/${lang}/reference/`}>{t(lang, 'reference.title')}</a></h2>
      <ol>
        {all.map((p) => (
          <li><a href={`${base}/${lang}/reference/${p.slug}/`} aria-current={p.slug === slug ? 'page' : undefined}><span class="n">{p.slug.slice(0, 2)}</span><span>{p.title}</span></a></li>
        ))}
      </ol>
    </nav>
    <div>
      <article class="reference">
        <Content />
      </article>
      <nav class="pager" aria-label="Navigation">
        {previous ? <a href={`${base}/${lang}/reference/${previous.slug}/`}>← {previous.title}</a> : <span />}
        {next ? <a href={`${base}/${lang}/reference/${next.slug}/`}>{next.title} →</a> : <span />}
      </nav>
    </div>
  </div>
</Base>
