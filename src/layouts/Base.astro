---
import '../styles/site.css';
import { strings, t } from '../i18n/index.js';
import { counterpart } from '../content.js';
const { lang, title, slug, section = 'cours' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const other = lang === 'fr' ? 'en' : 'fr';
// the same page in the other language, if it exists
const sectionPath = section === 'cours' ? '' : `${section}/`;
const otherSlug = slug ? counterpart(other, section, slug) : null;
const otherHref = otherSlug ? `${base}/${other}/${section}/${otherSlug}/` : `${base}/${other}/${sectionPath}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · qlang</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a href={`${base}/${lang}/`} class="brand"><span class="logo" aria-hidden="true">q</span>qlang</a>
        <nav class="main-nav" aria-label="Menu">
          <a href={`${base}/${lang}/`} data-testid="nav-lessons" aria-current={section === "cours" ? "page" : undefined}>{t(lang, 'nav.lessons')}</a>
          <a href={`${base}/${lang}/exercices/`} data-testid="nav-exercises" aria-current={section === "exercices" ? "page" : undefined}>{t(lang, 'nav.exercises')}</a>
          <a href={`${base}/${lang}/docs/`} data-testid="nav-docs" aria-current={section === "docs" ? "page" : undefined}>{t(lang, 'nav.docs')}</a>
        </nav>
        <a href={otherHref} hreflang={other} lang={other} class="lang" data-testid="switch-language">{t(lang, 'lang.switch')}</a>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <a href="https://github.com/quenti77/qlang">qlang</a> · <a href="https://github.com/quenti77/qlang-learn">{t(lang, 'footer.source')}</a>
    </footer>
    <script type="application/json" id="ui-strings" set:html={JSON.stringify(strings(lang))}></script>
    <script>
      import '../scripts/runner.js';
    </script>
  </body>
</html>
